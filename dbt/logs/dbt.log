    'C:/Krish/Project/sec-edgar-pipeline/data/raw/facts/*.json',
    -- Allow up to 32 MB per file — some companyfacts responses exceed the default
    maximum_object_size = 33554432,
    -- Let DuckDB infer column types automatically from the JSON structure
    auto_detect = true
)
    );
  
  
