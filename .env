# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your name and email — required by SEC EDGAR API as User-Agent header
SEC_USER_AGENT="FirstName LastName youremail@example.com"

# Absolute path to the DuckDB warehouse file
# Windows example: C:/Krish/Project/sec-edgar-pipeline/warehouse/edgar.duckdb
# Mac/Linux example: /home/user/sec-edgar-pipeline/warehouse/edgar.duckdb
DUCKDB_PATH="warehouse/edgar.duckdb"

# Airflow
AIRFLOW_UID=50000
